# Скопируйте в .env и заполните (файл .env в git не попадает). Загрузить: set -a; source .env; set +a
ANTHROPIC_API_KEY=            # для LLM-режима: console.anthropic.com -> API Keys
TELEGRAM_BOT_TOKEN=           # от @BotFather; без токена алерты пишутся в outbox (dry-run)
TELEGRAM_CHAT_ID=             # id чата/канала для алертов
# PA_DB_URL=postgresql+psycopg2://readonly:***@host:5432/db   # реальная БД вместо синтетики (только read-only роль!)
# PA_SQLITE_PATH=data/world.db                                # другой файл синтетического мира
